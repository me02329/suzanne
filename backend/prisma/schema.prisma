generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  expense
  income
  transfer
}

enum CategoryType {
  expense
  income
}

enum AccountType {
  checking
  savings
  livret_a
  ldds
  lep
  pel
  cel
  pea
  securities
  life_insurance
  crypto
  retirement
  cash
  credit
  loan
  receivable
  // Biens valorisés par estimation (relevés = estimations successives).
  real_estate
  valuable
  other
}

enum RecurringFrequency {
  weekly
  monthly
  yearly
}

enum BillFrequency {
  monthly
  yearly
}

// Classe d'actif d'une position (sert au regroupement de l'allocation).
enum AssetClass {
  equity
  etf
  fund
  bond
  crypto
  commodity
  cash
  other
}

enum OrderSide {
  buy
  sell
}

// Type d'alerte configurable (évaluée à la volée). account_balance /
// transaction_amount utilisent operator + threshold ; stale_snapshot utilise
// threshold = nb de jours ; goal_behind n'utilise que goal_id.
enum AlertType {
  account_balance
  transaction_amount
  stale_snapshot
  goal_behind
}

enum AlertOperator {
  lt
  gt
}

model User {
  id         Int      @id @default(autoincrement())
  // Identité stable du profil (ADR 0012) : reconnaît « le même profil » entre le
  // serveur et le téléphone, et lors d'un import de sauvegarde.
  uid        String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @unique
  created_at DateTime @default(now()) @db.Timestamptz(6)

  accounts               Account[]
  categories             Category[]
  transactions           Transaction[]
  budgets                Budget[]
  recurring_transactions RecurringTransaction[]
  institutions            Institution[]
  category_rules          CategoryRule[]
  savings_goals           SavingsGoal[]
  account_snapshots       AccountSnapshot[]
  tags                    Tag[]
  transaction_lines       TransactionLine[]
  goal_contributions      GoalContribution[]
  bills                   Bill[]
  bill_matches            BillMatch[]
  holdings                Holding[]
  holding_orders          HoldingOrder[]
  alerts                  Alert[]
  attachments             Attachment[]
  import_mappings         ImportMapping[]
  global_budgets          GlobalBudget[]
  sinking_funds           SinkingFund[]
  duplicate_dismissals    DuplicateDismissal[]
  tag_rules               TagRule[]
  bank_connections        BankConnection[]
  bank_links              BankLink[]

  @@map("users")
}

model Institution {
  id         Int      @id @default(autoincrement())
  // Identité stable (UUID) : conservée dans les sauvegardes, elle permet de
  // reconnaître l'élément d'une machine à l'autre même après modification.
  uid String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    Int
  name       String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  accounts Account[]

  @@unique([user_id, name])
  @@index([user_id])
  @@map("institutions")
}

model Account {
  id                   Int      @id @default(autoincrement())
  // Identité stable (UUID) : conservée dans les sauvegardes, elle permet de
  // reconnaître l'élément d'une machine à l'autre même après modification.
  uid String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              Int
  institution_id       Int?
  name                 String
  type                 AccountType
  currency             String   @default("EUR")
  initial_balance      Float    @default(0)
  initial_balance_date DateTime @db.Date
  // Compte clôturé : conservé pour l'historique/les soldes mais masqué des
  // sélecteurs de saisie. On archive au lieu de supprimer (qui détacherait
  // les transactions via onDelete: SetNull et rendrait l'historique incohérent).
  archived             Boolean  @default(false)
  // Compte-titres / PEA : chaque ordre de bourse génère son mouvement
  // d'espèces (opération kind=trade). Désactivé par défaut pour ne pas
  // modifier rétroactivement les soldes des comptes existants.
  orders_affect_cash   Boolean  @default(false)
  // Compte professionnel (ex. SASU) : visible (trésorerie, virements avec les
  // comptes perso) mais ses opérations ne comptent jamais dans les dépenses,
  // revenus, budgets et statistiques personnels. Groupe « Société » du patrimoine.
  professional         Boolean  @default(false)
  // Bien immobilier / de valeur : prêt qui le finance (capital net = valeur − reste dû).
  linked_account_id    Int?
  // Frais annuels du placement en % (gestion du contrat + frais des fonds) :
  // coût estimé et rendement net dans la fiche du compte.
  annual_fee_rate      Float?
  // Date fiscale (PEA : date du premier versement, règle des 5 ans ;
  // assurance-vie : 8 ans). Null = date d'ouverture.
  fiscal_start_date    DateTime? @db.Date
  created_at           DateTime @default(now()) @db.Timestamptz(6)

  user                   User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  institution            Institution?           @relation(fields: [institution_id], references: [id], onDelete: SetNull)
  linked_account         Account?               @relation("LinkedAccount", fields: [linked_account_id], references: [id], onDelete: SetNull)
  linked_by              Account[]              @relation("LinkedAccount")
  transaction_lines      TransactionLine[]
  recurring_transactions RecurringTransaction[] @relation("RecurringSource")
  recurring_incoming     RecurringTransaction[] @relation("RecurringDestination")
  snapshots              AccountSnapshot[]
  savings_goals          SavingsGoal[]
  bills                  Bill[]
  holdings               Holding[]
  alerts                 Alert[]
  bank_links             BankLink[]

  @@unique([user_id, name])
  @@index([user_id])
  @@index([institution_id])
  @@map("accounts")
}

model Category {
  id         Int      @id @default(autoincrement())
  // Identité stable (UUID) : conservée dans les sauvegardes, elle permet de
  // reconnaître l'élément d'une machine à l'autre même après modification.
  uid String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    Int
  name       String
  type       CategoryType
  color      String   @default("#6366f1")
  icon       String?
  // Aide affichée au survol (ce que la catégorie couvre, exemples…).
  description String?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user                   User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transaction_lines      TransactionLine[]
  budgets                Budget[]
  recurring_transactions RecurringTransaction[]
  category_rules          CategoryRule[]
  bills                   Bill[]
  sinking_funds           SinkingFund[]

  @@unique([user_id, name, type])
  @@index([user_id, type])
  @@map("categories")
}

model CategoryRule {
  id          Int      @id @default(autoincrement())
  user_id     Int
  pattern     String
  category_id Int
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([user_id, pattern])
  @@index([user_id])
  @@map("category_rules")
}

// Genre d'opération : comment lire ses lignes (cf. docs/ARCHITECTURE-ledger.md).
enum TransactionKind {
  standard
  transfer
  trade
  adjustment
}

// Opération : en-tête (date, libellé, pointage, tags…). Les montants vivent
// dans ses lignes (TransactionLine), une par compte/catégorie touché.
model Transaction {
  id            Int             @id @default(autoincrement())
  // Identité stable (UUID) : conservée dans les sauvegardes, elle permet de
  // reconnaître l'élément d'une machine à l'autre même après modification.
  uid String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       Int
  kind          TransactionKind @default(standard)
  recurring_transaction_id Int?
  // Remboursement : l'opération rembourse cette dépense (affichage et
  // rapprochement ; les montants remboursés sont portés par les lignes).
  refunds_transaction_id Int?
  date          DateTime        @db.Date
  description   String?
  // Pointage : la ligne a été rapprochée du relevé bancaire.
  cleared       Boolean         @default(false)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  // Soft-delete : corbeille restaurable ; purge = suppression définitive.
  deleted_at    DateTime?       @db.Timestamptz(6)
  // Empreinte de la ligne de relevé d'origine (identifiant OFX de la banque, ou
  // hash de la ligne CSV brute) : un relevé réimporté n'est jamais dupliqué,
  // même si l'opération a été renommée ou recatégorisée depuis.
  import_fingerprint String?
  // Données brutes de la banque (synchro Enable Banking) : une entrée par côté
  // synchronisé (un virement entre deux comptes liés en a deux). Affichées dans
  // la fiche de l'opération ; absentes pour les saisies et les anciens imports.
  bank_data  Json?

  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  recurring_transaction RecurringTransaction? @relation(fields: [recurring_transaction_id], references: [id], onDelete: SetNull)
  refunds_transaction Transaction?  @relation("Refunds", fields: [refunds_transaction_id], references: [id], onDelete: SetNull)
  refunded_by         Transaction[] @relation("Refunds")
  lines              TransactionLine[]
  // Lignes d'autres opérations qui remboursent celle-ci.
  refund_lines       TransactionLine[] @relation("RefundLines")
  tags               TransactionTag[]
  goal_contributions GoalContribution[]
  bill_matches       BillMatch[]
  attachments        Attachment[]
  holding_order      HoldingOrder?
  dismissals_a       DuplicateDismissal[] @relation("DismissalA")
  dismissals_b       DuplicateDismissal[] @relation("DismissalB")

  @@unique([user_id, import_fingerprint])
  @@index([user_id, date])
  @@index([user_id, deleted_at])
  @@index([recurring_transaction_id])
  @@index([refunds_transaction_id])
  @@map("transactions")
}

// Ligne d'opération : montant signé (devise du compte) sur un compte, avec
// catégorie optionnelle. Somme des lignes d'un compte = mouvement du compte.
model TransactionLine {
  id             Int      @id @default(autoincrement())
  user_id        Int
  transaction_id Int
  // null = opération hors compte (à affecter).
  account_id     Int?
  category_id    Int?
  amount         Float
  // Ligne de remboursement : ne compte que pour les lignes sans catégorie
  // (sinon c'est le type de la catégorie qui fixe le côté dépense/revenu).
  refund         Boolean  @default(false)
  // Ligne de remboursement : la dépense remboursée par CETTE ligne (un
  // remboursement peut couvrir plusieurs dépenses).
  refund_of_id   Int?
  note           String?
  position       Int      @default(0)

  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  // NoAction (vérifié en fin d'instruction) : impossible de supprimer un compte
  // qui porte des lignes (il faut l'archiver), mais la suppression en cascade
  // d'un utilisateur reste possible.
  account     Account?    @relation(fields: [account_id], references: [id], onDelete: NoAction)
  // Supprimer une catégorie décatégorise la ligne au lieu de la supprimer.
  category    Category?   @relation(fields: [category_id], references: [id], onDelete: SetNull)
  refund_of   Transaction? @relation("RefundLines", fields: [refund_of_id], references: [id], onDelete: SetNull)

  @@index([transaction_id])
  @@index([refund_of_id])
  @@index([account_id])
  @@index([category_id])
  @@index([user_id])
  @@map("transaction_lines")
}



model Tag {
  id         Int      @id @default(autoincrement())
  // Identité stable (UUID) : conservée dans les sauvegardes, elle permet de
  // reconnaître l'élément d'une machine à l'autre même après modification.
  uid String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    Int
  name       String
  color      String   @default("#6366f1")
  // Opérations portant ce tag ignorées par les budgets (ex. frais pro).
  exclude_from_budgets Boolean @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user         User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions TransactionTag[]
  rules        TagRule[]

  @@unique([user_id, name])
  @@index([user_id])
  @@map("tags")
}

model TransactionTag {
  transaction_id Int
  tag_id         Int

  transaction Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([transaction_id, tag_id])
  @@index([tag_id])
  @@map("transaction_tags")
}

model Budget {
  id           Int      @id @default(autoincrement())
  user_id      Int
  category_id  Int
  month        String
  amount_limit Float
  recurring    Boolean  @default(false)
  // Report d'enveloppe : le solde (non dépensé ou dépassement) bascule sur le
  // mois suivant. La limite effective d'un mois = limite + report cumulé.
  rollover     Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([user_id, category_id, month])
  @@index([user_id, month])
  @@map("budgets")
}

// Budget global du mois (toutes dépenses confondues) : le « reste à vivre ».
// Reconduction identique aux budgets par catégorie.
model GlobalBudget {
  id           Int      @id @default(autoincrement())
  user_id      Int
  month        String
  amount_limit Float
  recurring    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, month])
  @@map("global_budgets")
}

// Provision pour dépense irrégulière (vacances, assurance annuelle…) : un
// objectif à réunir tous les `period_months` mois, lissé en mensualités. Les
// dépenses de la catégorie liée sur le cycle viennent en déduction. Enveloppe
// virtuelle : aucun argent n'est déplacé.
model SinkingFund {
  id            Int      @id @default(autoincrement())
  // Identité stable (UUID) : conservée dans les sauvegardes, elle permet de
  // reconnaître l'élément d'une machine à l'autre même après modification.
  uid String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       Int
  name          String
  category_id   Int?
  target_amount Float
  period_months Int      @default(12)
  start_month   String
  color         String   @default("#4a6a00")
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [category_id], references: [id], onDelete: SetNull)

  @@unique([user_id, name])
  @@index([user_id])
  @@map("sinking_funds")
}

model RecurringTransaction {
  id            Int       @id @default(autoincrement())
  // Identité stable (UUID) : conservée dans les sauvegardes, elle permet de
  // reconnaître l'élément d'une machine à l'autre même après modification.
  uid String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       Int
  account_id    Int?
  // Virement (type = transfer) : compte de destination (ex. le compte d'un
  // prêt pour une mensualité, un livret pour une épargne programmée).
  to_account_id Int?
  category_id   Int?
  amount        Float
  type          TransactionType
  description   String
  frequency     RecurringFrequency
  interval      Int       @default(1)
  day_of_month  Int?
  month_of_year Int?
  active        Boolean   @default(true)
  // Date de fin optionnelle : aucune occurrence générée au-delà ; la récurrence
  // se désactive d'elle-même une fois la date passée.
  end_date      DateTime? @db.Date
  last_executed DateTime? @db.Date
  created_at    DateTime  @default(now()) @db.Timestamptz(6)

  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account    Account?  @relation("RecurringSource", fields: [account_id], references: [id], onDelete: SetNull)
  to_account Account?  @relation("RecurringDestination", fields: [to_account_id], references: [id], onDelete: SetNull)
  category   Category? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([user_id, active])
  @@map("recurring_transactions")
}

model SavingsGoal {
  id             Int      @id @default(autoincrement())
  // Identité stable (UUID) : conservée dans les sauvegardes, elle permet de
  // reconnaître l'élément d'une machine à l'autre même après modification.
  uid String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        Int
  account_id     Int?
  name           String
  target_amount  Float
  current_amount Float    @default(0)
  deadline       DateTime? @db.Date
  color          String   @default("#4f46e5")
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  user          User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account       Account?           @relation(fields: [account_id], references: [id], onDelete: SetNull)
  contributions GoalContribution[]
  alerts        Alert[]

  @@index([user_id])
  @@index([account_id])
  @@map("savings_goals")
}

// Historique des versements sur un objectif : chaque contribution garde sa
// trace (et le transfert créé le cas échéant) au lieu de seulement bumper
// current_amount.
model GoalContribution {
  id             Int      @id @default(autoincrement())
  user_id        Int
  goal_id        Int
  transaction_id Int?
  amount         Float
  date           DateTime @db.Date
  description    String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  goal        SavingsGoal  @relation(fields: [goal_id], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transaction_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([goal_id, date])
  @@map("goal_contributions")
}

// Facture attendue (modèle Firefly `Bill`) : une dépense récurrente avec une
// fourchette de montant, rapprochée des transactions réelles par motif sur la
// description. `start_date` ancre la répétition (mois de départ + jour attendu).
model Bill {
  id          Int           @id @default(autoincrement())
  // Identité stable (UUID) : conservée dans les sauvegardes, elle permet de
  // reconnaître l'élément d'une machine à l'autre même après modification.
  uid String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     Int
  account_id  Int?
  category_id Int?
  name        String
  amount_min  Float
  amount_max  Float
  start_date  DateTime      @db.Date
  frequency   BillFrequency @default(monthly)
  interval    Int           @default(1)
  // Motif de rapprochement (contains, insensible à la casse). Vide = le nom.
  pattern     String?
  active      Boolean       @default(true)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)

  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account  Account?  @relation(fields: [account_id], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  matches  BillMatch[]

  @@unique([user_id, name])
  @@index([user_id, active])
  @@map("bills")
}

// Rapprochement manuel : lie une dépense réelle à une facture quand le motif
// ne matche pas (paiement en espèces, libellé bancaire variable). La dépense
// compte alors comme paiement de la facture sur le mois de sa date.
model BillMatch {
  id             Int      @id @default(autoincrement())
  user_id        Int
  bill_id        Int
  transaction_id Int
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  bill        Bill        @relation(fields: [bill_id], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  @@unique([bill_id, transaction_id])
  @@index([user_id])
  @@index([transaction_id])
  @@map("bill_matches")
}

model Setting {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@map("settings")
}

model AccountSnapshot {
  id         Int      @id @default(autoincrement())
  user_id    Int
  account_id Int
  date       DateTime @db.Date
  balance    Float
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@unique([account_id, date])
  @@index([user_id, date])
  @@map("account_snapshots")
}

// Cache persistant des taux de change quotidiens. Les taux historiques sont
// immuables une fois le marché clôturé : on les stocke pour que la conversion
// du patrimoine historique (wealth-history) soit durable et rapide, au lieu de
// ré-interroger Yahoo à chaque chargement (le cache mémoire de fx.ts est perdu
// au redémarrage). Données universelles, non scopées par utilisateur.
model ExchangeRate {
  id         Int       @id @default(autoincrement())
  base       String    @db.VarChar(3)
  quote      String    @db.VarChar(3)
  date       DateTime  @db.Date
  rate       Float
  as_of      DateTime? @db.Date
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([base, quote, date])
  @@map("exchange_rates")
}

// Une position détenue sur un compte d'investissement (PEA, compte-titres,
// crypto…). La quantité n'est pas stockée : elle se déduit du carnet d'ordres
// (Σ achats − Σ ventes). `symbol` est le ticker interrogé pour le cours
// (ex. AAPL, CW8.PA, BTC-EUR) ; `currency` est la devise de cotation du titre,
// convertie ensuite vers la devise du compte puis la devise de reporting.
model Holding {
  id          Int        @id @default(autoincrement())
  // Identité stable (UUID) : conservée dans les sauvegardes, elle permet de
  // reconnaître l'élément d'une machine à l'autre même après modification.
  uid String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     Int
  account_id  Int
  symbol      String
  name        String
  asset_class AssetClass @default(equity)
  currency    String     @default("EUR")
  created_at  DateTime   @default(now()) @db.Timestamptz(6)

  user    User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account Account        @relation(fields: [account_id], references: [id], onDelete: Cascade)
  orders  HoldingOrder[]

  @@unique([account_id, symbol])
  @@index([user_id])
  @@map("holdings")
}

// Carnet d'ordres d'une position : la quantité courante et le prix de revient
// (PRU) en dérivent → plus-value latente, performance, allocation.
model HoldingOrder {
  id         Int       @id @default(autoincrement())
  user_id    Int
  holding_id Int
  side       OrderSide
  date       DateTime  @db.Date
  quantity   Float
  unit_price Float
  fee        Float     @default(0)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  holding Holding @relation(fields: [holding_id], references: [id], onDelete: Cascade)
  // Mouvement d'espèces de l'ordre (opération kind=trade) sur le compte.
  cash_transaction_id Int?         @unique
  cash_transaction    Transaction? @relation(fields: [cash_transaction_id], references: [id], onDelete: SetNull)

  @@index([holding_id, date])
  @@index([user_id])
  @@map("holding_orders")
}

// Cache persistant des cours quotidiens, jumeau d'ExchangeRate. Un cours
// historique est immuable une fois le marché clôturé : on le mémorise pour
// valoriser le patrimoine dans le temps sans ré-interroger Yahoo. `currency`
// est la devise de cotation renvoyée par le fournisseur. Non scopé par
// utilisateur (donnée de marché universelle).
model MarketData {
  id         Int      @id @default(autoincrement())
  symbol     String
  date       DateTime @db.Date
  price      Float
  currency   String?
  as_of      DateTime? @db.Date
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([symbol, date])
  @@map("market_data")
}

// Pièce jointe (reçu, justificatif) rattachée à une transaction. Le contenu est
// stocké en base (bytea) plutôt que sur disque : pas de volume à monter, et la
// sauvegarde reste l'export de la base. Adapté à des fichiers de quelques Mo.
model Attachment {
  id             Int      @id @default(autoincrement())
  user_id        Int
  transaction_id Int
  filename       String
  mime_type      String
  size           Int
  data           Bytes
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([transaction_id])
  @@map("attachments")
}

// Mapping CSV sauvegardé (« profil de banque ») : colonnes + format de date,
// pour ré-importer un relevé de la même banque sans tout reconfigurer.
model ImportMapping {
  id          Int      @id @default(autoincrement())
  user_id     Int
  name        String
  date_format String   @default("auto")
  // Colonnes : { date, amount, description?, type? } (noms d'en-têtes CSV).
  columns     Json
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, name])
  @@index([user_id])
  @@map("import_mappings")
}

// Journal d'audit : trace des mutations (qui/quoi/quand). Alimenté par un
// middleware après chaque écriture réussie ; lecture seule côté UI.
model AuditLog {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  action     String   // POST | PATCH | PUT | DELETE
  entity     String   // segment de ressource (transactions, budgets…)
  entity_id  Int?
  status     Int
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id, created_at])
  @@map("audit_log")
}

// Sauvegarde automatique ou manuelle : snapshot JSON complet stocké en base
// (comme les pièces jointes : pas de volume, restaurable). Rotation par nombre.
model Backup {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  label      String
  size       Int
  auto       Boolean  @default(false)
  data       Bytes
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at])
  @@map("backups")
}

// Alerte configurable, évaluée à la volée (pas de canal d'envoi pour l'instant :
// les déclenchements sont calculés et affichés au chargement). Selon le type :
// - account_balance   : account_id + operator + threshold (montant)
// - transaction_amount: operator + threshold (montant), account_id optionnel
// - stale_snapshot    : account_id optionnel + threshold (nb de jours)
// - goal_behind       : goal_id
model Alert {
  id         Int            @id @default(autoincrement())
  user_id    Int
  type       AlertType
  account_id Int?
  goal_id    Int?
  operator   AlertOperator?
  threshold  Float?
  active     Boolean        @default(true)
  created_at DateTime       @default(now()) @db.Timestamptz(6)

  user    User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account Account?     @relation(fields: [account_id], references: [id], onDelete: Cascade)
  goal    SavingsGoal? @relation(fields: [goal_id], references: [id], onDelete: Cascade)

  @@index([user_id, active])
  @@map("alerts")
}

// Paire signalée comme doublon probable que l'utilisateur a validée (« ce
// n'est pas un doublon ») : elle n'est plus proposée. a_id < b_id.
model DuplicateDismissal {
  id         Int      @id @default(autoincrement())
  user_id    Int
  a_id       Int
  b_id       Int
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  a    Transaction @relation("DismissalA", fields: [a_id], references: [id], onDelete: Cascade)
  b    Transaction @relation("DismissalB", fields: [b_id], references: [id], onDelete: Cascade)

  @@unique([user_id, a_id, b_id])
  @@index([b_id])
  @@map("duplicate_dismissals")
}

// Règle de tag : un libellé contenant `pattern` (majuscules) reçoit le tag, à
// l'import et via « appliquer ». Plusieurs règles peuvent poser plusieurs tags
// sur la même opération (contrairement aux règles de catégorie).
model TagRule {
  id         Int      @id @default(autoincrement())
  user_id    Int
  pattern    String
  tag_id     Int
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@unique([user_id, pattern, tag_id])
  @@index([user_id])
  @@map("tag_rules")
}

// Synchronisation bancaire DSP2 via Enable Banking (docs/ENABLE-BANKING.md).
// Une connexion = un consentement donné à une banque (session Enable Banking,
// valable jusqu'à valid_until) ; chaque compte distant autorisé est un lien,
// associé (ou non) à un compte Suzanne. Aucun identifiant bancaire n'est stocké :
// la session ne sert qu'avec la clé privée de l'application (hors base).
// Non inclus dans les sauvegardes.
model BankConnection {
  id            Int       @id @default(autoincrement())
  user_id       Int
  aspsp_name    String
  aspsp_country String
  session_id    String    @unique
  valid_until   DateTime  @db.Timestamptz(6)
  // active | expired | revoked | error
  status        String    @default("active")
  last_sync_at  DateTime? @db.Timestamptz(6)
  // Dernière tentative, réussie ou non (planification de la synchro automatique).
  last_attempt_at DateTime? @db.Timestamptz(6)
  last_error    String?
  created_at    DateTime  @default(now()) @db.Timestamptz(6)

  user  User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  links BankLink[]

  @@index([user_id])
  @@map("bank_connections")
}

model BankLink {
  id            Int       @id @default(autoincrement())
  user_id       Int
  connection_id Int
  remote_uid    String
  remote_name   String?
  iban_last4    String?
  currency      String?
  account_id    Int?
  // Première date synchronisée (évite de réimporter l'historique déjà importé en CSV).
  sync_from     DateTime? @db.Date
  last_sync_at  DateTime? @db.Timestamptz(6)
  last_result   Json?

  user       User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  connection BankConnection @relation(fields: [connection_id], references: [id], onDelete: Cascade)
  account    Account?       @relation(fields: [account_id], references: [id], onDelete: SetNull)

  @@unique([connection_id, remote_uid])
  @@index([user_id])
  @@index([account_id])
  @@map("bank_links")
}
