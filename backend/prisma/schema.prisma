generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  expense
  income
  transfer
}

enum CategoryType {
  expense
  income
}

enum AccountType {
  checking
  savings
  livret_a
  ldds
  lep
  pel
  cel
  pea
  securities
  life_insurance
  crypto
  retirement
  cash
  credit
  loan
  other
}

enum RecurringFrequency {
  weekly
  monthly
  yearly
}

enum BillFrequency {
  monthly
  yearly
}

// Classe d'actif d'une position (sert au regroupement de l'allocation).
enum AssetClass {
  equity
  etf
  fund
  bond
  crypto
  commodity
  cash
  other
}

enum OrderSide {
  buy
  sell
}

// Type d'alerte configurable (évaluée à la volée). account_balance /
// transaction_amount utilisent operator + threshold ; stale_snapshot utilise
// threshold = nb de jours ; goal_behind n'utilise que goal_id.
enum AlertType {
  account_balance
  transaction_amount
  stale_snapshot
  goal_behind
}

enum AlertOperator {
  lt
  gt
}

model User {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  created_at DateTime @default(now()) @db.Timestamptz(6)

  accounts               Account[]
  categories             Category[]
  transactions           Transaction[]
  budgets                Budget[]
  recurring_transactions RecurringTransaction[]
  institutions            Institution[]
  category_rules          CategoryRule[]
  savings_goals           SavingsGoal[]
  account_snapshots       AccountSnapshot[]
  tags                    Tag[]
  transaction_splits      TransactionSplit[]
  refund_allocations      RefundAllocation[]
  goal_contributions      GoalContribution[]
  bills                   Bill[]
  bill_matches            BillMatch[]
  holdings                Holding[]
  holding_orders          HoldingOrder[]
  alerts                  Alert[]
  attachments             Attachment[]

  @@map("users")
}

model Institution {
  id         Int      @id @default(autoincrement())
  user_id    Int
  name       String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  accounts Account[]

  @@unique([user_id, name])
  @@index([user_id])
  @@map("institutions")
}

model Account {
  id                   Int      @id @default(autoincrement())
  user_id              Int
  institution_id       Int?
  name                 String
  type                 AccountType
  currency             String   @default("EUR")
  initial_balance      Float    @default(0)
  initial_balance_date DateTime @db.Date
  // Compte clôturé : conservé pour l'historique/les soldes mais masqué des
  // sélecteurs de saisie. On archive au lieu de supprimer (qui détacherait
  // les transactions via onDelete: SetNull et rendrait l'historique incohérent).
  archived             Boolean  @default(false)
  created_at           DateTime @default(now()) @db.Timestamptz(6)

  user                   User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  institution            Institution?           @relation(fields: [institution_id], references: [id], onDelete: SetNull)
  transactions           Transaction[]          @relation("TxSource")
  incoming_transactions  Transaction[]          @relation("TxDestination")
  recurring_transactions RecurringTransaction[]
  snapshots              AccountSnapshot[]
  savings_goals          SavingsGoal[]
  bills                  Bill[]
  holdings               Holding[]
  alerts                 Alert[]

  @@unique([user_id, name])
  @@index([user_id])
  @@index([institution_id])
  @@map("accounts")
}

model Category {
  id         Int      @id @default(autoincrement())
  user_id    Int
  name       String
  type       CategoryType
  color      String   @default("#6366f1")
  icon       String?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user                   User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions           Transaction[]
  transaction_splits      TransactionSplit[]
  budgets                Budget[]
  recurring_transactions RecurringTransaction[]
  category_rules          CategoryRule[]
  bills                   Bill[]

  @@unique([user_id, name, type])
  @@index([user_id, type])
  @@map("categories")
}

model CategoryRule {
  id          Int      @id @default(autoincrement())
  user_id     Int
  pattern     String
  category_id Int
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([user_id, pattern])
  @@index([user_id])
  @@map("category_rules")
}

model Transaction {
  id            Int             @id @default(autoincrement())
  user_id       Int
  account_id    Int?
  to_account_id Int?
  category_id   Int?
  recurring_transaction_id Int?
  // Remboursement : un revenu peut pointer la dépense qu'il rembourse.
  // Plusieurs revenus peuvent pointer la même dépense (remboursements partiels).
  refunds_transaction_id Int?
  amount        Float
  to_amount     Float?
  exchange_rate Float?
  type          TransactionType
  date          DateTime        @db.Date
  description   String?
  // Pointage : la ligne a été rapprochée du relevé bancaire.
  cleared       Boolean         @default(false)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)

  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account    Account?  @relation("TxSource", fields: [account_id], references: [id], onDelete: SetNull)
  to_account Account?  @relation("TxDestination", fields: [to_account_id], references: [id], onDelete: SetNull)
  category   Category? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  recurring_transaction RecurringTransaction? @relation(fields: [recurring_transaction_id], references: [id], onDelete: SetNull)
  refunds_transaction Transaction?  @relation("Refunds", fields: [refunds_transaction_id], references: [id], onDelete: SetNull)
  refunded_by         Transaction[] @relation("Refunds")
  tags       TransactionTag[]
  splits     TransactionSplit[]
  refund_allocations_sent     RefundAllocation[] @relation("RefundAllocationRefund")
  refund_allocations_received RefundAllocation[] @relation("RefundAllocationExpense")
  goal_contributions          GoalContribution[]
  bill_matches                BillMatch[]
  attachments                 Attachment[]

  @@index([user_id, date])
  @@index([account_id])
  @@index([to_account_id])
  @@index([category_id])
  @@index([recurring_transaction_id])
  @@index([refunds_transaction_id])
  @@map("transactions")
}

model RefundAllocation {
  id                     Int      @id @default(autoincrement())
  user_id                Int
  refund_transaction_id  Int
  expense_transaction_id Int
  amount                 Float
  created_at             DateTime @default(now()) @db.Timestamptz(6)

  user                User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  refund_transaction  Transaction @relation("RefundAllocationRefund", fields: [refund_transaction_id], references: [id], onDelete: Cascade)
  expense_transaction Transaction @relation("RefundAllocationExpense", fields: [expense_transaction_id], references: [id], onDelete: Cascade)

  @@unique([refund_transaction_id, expense_transaction_id])
  @@index([user_id])
  @@index([refund_transaction_id])
  @@index([expense_transaction_id])
  @@map("refund_allocations")
}

model TransactionSplit {
  id             Int      @id @default(autoincrement())
  user_id        Int
  transaction_id Int
  category_id    Int
  amount         Float
  note           String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([transaction_id])
  @@index([category_id])
  @@map("transaction_splits")
}

model Tag {
  id         Int      @id @default(autoincrement())
  user_id    Int
  name       String
  color      String   @default("#6366f1")
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user         User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions TransactionTag[]

  @@unique([user_id, name])
  @@index([user_id])
  @@map("tags")
}

model TransactionTag {
  transaction_id Int
  tag_id         Int

  transaction Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([transaction_id, tag_id])
  @@index([tag_id])
  @@map("transaction_tags")
}

model Budget {
  id           Int      @id @default(autoincrement())
  user_id      Int
  category_id  Int
  month        String
  amount_limit Float
  recurring    Boolean  @default(false)
  // Report d'enveloppe : le solde (non dépensé ou dépassement) bascule sur le
  // mois suivant. La limite effective d'un mois = limite + report cumulé.
  rollover     Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([user_id, category_id, month])
  @@index([user_id, month])
  @@map("budgets")
}

model RecurringTransaction {
  id            Int       @id @default(autoincrement())
  user_id       Int
  account_id    Int?
  category_id   Int?
  amount        Float
  type          TransactionType
  description   String
  frequency     RecurringFrequency
  interval      Int       @default(1)
  day_of_month  Int?
  month_of_year Int?
  active        Boolean   @default(true)
  // Date de fin optionnelle : aucune occurrence générée au-delà ; la récurrence
  // se désactive d'elle-même une fois la date passée.
  end_date      DateTime? @db.Date
  last_executed DateTime? @db.Date
  created_at    DateTime  @default(now()) @db.Timestamptz(6)

  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account  Account?  @relation(fields: [account_id], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([user_id, active])
  @@map("recurring_transactions")
}

model SavingsGoal {
  id             Int      @id @default(autoincrement())
  user_id        Int
  account_id     Int?
  name           String
  target_amount  Float
  current_amount Float    @default(0)
  deadline       DateTime? @db.Date
  color          String   @default("#4f46e5")
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  user          User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account       Account?           @relation(fields: [account_id], references: [id], onDelete: SetNull)
  contributions GoalContribution[]
  alerts        Alert[]

  @@index([user_id])
  @@index([account_id])
  @@map("savings_goals")
}

// Historique des versements sur un objectif : chaque contribution garde sa
// trace (et le transfert créé le cas échéant) au lieu de seulement bumper
// current_amount.
model GoalContribution {
  id             Int      @id @default(autoincrement())
  user_id        Int
  goal_id        Int
  transaction_id Int?
  amount         Float
  date           DateTime @db.Date
  description    String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  goal        SavingsGoal  @relation(fields: [goal_id], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transaction_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([goal_id, date])
  @@map("goal_contributions")
}

// Facture attendue (modèle Firefly `Bill`) : une dépense récurrente avec une
// fourchette de montant, rapprochée des transactions réelles par motif sur la
// description. `start_date` ancre la répétition (mois de départ + jour attendu).
model Bill {
  id          Int           @id @default(autoincrement())
  user_id     Int
  account_id  Int?
  category_id Int?
  name        String
  amount_min  Float
  amount_max  Float
  start_date  DateTime      @db.Date
  frequency   BillFrequency @default(monthly)
  interval    Int           @default(1)
  // Motif de rapprochement (contains, insensible à la casse). Vide = le nom.
  pattern     String?
  active      Boolean       @default(true)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)

  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account  Account?  @relation(fields: [account_id], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  matches  BillMatch[]

  @@unique([user_id, name])
  @@index([user_id, active])
  @@map("bills")
}

// Rapprochement manuel : lie une dépense réelle à une facture quand le motif
// ne matche pas (paiement en espèces, libellé bancaire variable). La dépense
// compte alors comme paiement de la facture sur le mois de sa date.
model BillMatch {
  id             Int      @id @default(autoincrement())
  user_id        Int
  bill_id        Int
  transaction_id Int
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  bill        Bill        @relation(fields: [bill_id], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  @@unique([bill_id, transaction_id])
  @@index([user_id])
  @@index([transaction_id])
  @@map("bill_matches")
}

model Setting {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@map("settings")
}

model AccountSnapshot {
  id         Int      @id @default(autoincrement())
  user_id    Int
  account_id Int
  date       DateTime @db.Date
  balance    Float
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@unique([account_id, date])
  @@index([user_id, date])
  @@map("account_snapshots")
}

// Cache persistant des taux de change quotidiens. Les taux historiques sont
// immuables une fois le marché clôturé : on les stocke pour que la conversion
// du patrimoine historique (wealth-history) soit durable et rapide, au lieu de
// ré-interroger Yahoo à chaque chargement (le cache mémoire de fx.ts est perdu
// au redémarrage). Données universelles, non scopées par utilisateur.
model ExchangeRate {
  id         Int       @id @default(autoincrement())
  base       String    @db.VarChar(3)
  quote      String    @db.VarChar(3)
  date       DateTime  @db.Date
  rate       Float
  as_of      DateTime? @db.Date
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([base, quote, date])
  @@map("exchange_rates")
}

// Une position détenue sur un compte d'investissement (PEA, compte-titres,
// crypto…). La quantité n'est pas stockée : elle se déduit du carnet d'ordres
// (Σ achats − Σ ventes). `symbol` est le ticker interrogé pour le cours
// (ex. AAPL, CW8.PA, BTC-EUR) ; `currency` est la devise de cotation du titre,
// convertie ensuite vers la devise du compte puis la devise de reporting.
model Holding {
  id          Int        @id @default(autoincrement())
  user_id     Int
  account_id  Int
  symbol      String
  name        String
  asset_class AssetClass @default(equity)
  currency    String     @default("EUR")
  created_at  DateTime   @default(now()) @db.Timestamptz(6)

  user    User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account Account        @relation(fields: [account_id], references: [id], onDelete: Cascade)
  orders  HoldingOrder[]

  @@unique([account_id, symbol])
  @@index([user_id])
  @@map("holdings")
}

// Carnet d'ordres d'une position : la quantité courante et le prix de revient
// (PRU) en dérivent → plus-value latente, performance, allocation.
model HoldingOrder {
  id         Int       @id @default(autoincrement())
  user_id    Int
  holding_id Int
  side       OrderSide
  date       DateTime  @db.Date
  quantity   Float
  unit_price Float
  fee        Float     @default(0)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  holding Holding @relation(fields: [holding_id], references: [id], onDelete: Cascade)

  @@index([holding_id, date])
  @@index([user_id])
  @@map("holding_orders")
}

// Cache persistant des cours quotidiens, jumeau d'ExchangeRate. Un cours
// historique est immuable une fois le marché clôturé : on le mémorise pour
// valoriser le patrimoine dans le temps sans ré-interroger Yahoo. `currency`
// est la devise de cotation renvoyée par le fournisseur. Non scopé par
// utilisateur (donnée de marché universelle).
model MarketData {
  id         Int      @id @default(autoincrement())
  symbol     String
  date       DateTime @db.Date
  price      Float
  currency   String?
  as_of      DateTime? @db.Date
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([symbol, date])
  @@map("market_data")
}

// Pièce jointe (reçu, justificatif) rattachée à une transaction. Le contenu est
// stocké en base (bytea) plutôt que sur disque : pas de volume à monter, et la
// sauvegarde reste l'export de la base. Adapté à des fichiers de quelques Mo.
model Attachment {
  id             Int      @id @default(autoincrement())
  user_id        Int
  transaction_id Int
  filename       String
  mime_type      String
  size           Int
  data           Bytes
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([transaction_id])
  @@map("attachments")
}

// Alerte configurable, évaluée à la volée (pas de canal d'envoi pour l'instant :
// les déclenchements sont calculés et affichés au chargement). Selon le type :
// - account_balance   : account_id + operator + threshold (montant)
// - transaction_amount: operator + threshold (montant), account_id optionnel
// - stale_snapshot    : account_id optionnel + threshold (nb de jours)
// - goal_behind       : goal_id
model Alert {
  id         Int            @id @default(autoincrement())
  user_id    Int
  type       AlertType
  account_id Int?
  goal_id    Int?
  operator   AlertOperator?
  threshold  Float?
  active     Boolean        @default(true)
  created_at DateTime       @default(now()) @db.Timestamptz(6)

  user    User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account Account?     @relation(fields: [account_id], references: [id], onDelete: Cascade)
  goal    SavingsGoal? @relation(fields: [goal_id], references: [id], onDelete: Cascade)

  @@index([user_id, active])
  @@map("alerts")
}
