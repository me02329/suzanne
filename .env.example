DATABASE_URL=postgres://suzanne:suzanne@localhost:5432/suzanne
PORT=3000
NODE_ENV=development

# Optional shared-secret protection for /api/*.
# Leave empty for local private development.
APP_TOKEN=

# Optional AI assistant configuration. Can also be configured from the app UI.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_BASE_URL=https://api.openai.com/v1

# Origines autorisées à appeler l API depuis un autre domaine (séparées par des virgules).
# Vide = même origine uniquement (le front est servi par l app).
CORS_ORIGIN=

# Synchronisation bancaire Enable Banking (facultative) : voir docs/ENABLE-BANKING.md.
# Clé privée dans secrets/enablebanking.pem (Docker) ou chemin explicite (dev).
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_KEY_PATH=
ENABLE_BANKING_REDIRECT_URL=
